generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user") // "user" | "admin"
  status    String   @default("active") // "active" | "suspended"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  clients   Client[]
  budgetLogs BudgetLog[]
  shareLinks ShareLink[]
  pauseEvents PauseEvent[] @relation("PauseCreatedBy")
  notifications Notification[]
  ownedNotes Note[] @relation("OwnedNotes")
  sharedNotes NoteShare[] @relation("SharedNotes")
  noteSecretAccesses NoteSecretAccessLog[] @relation("NoteSecretAccesses")

  @@map("users")
}

model Settings {
  id                 Int      @id @default(autoincrement())
  appName            String   @default("Ad Budget Tracker") @map("app_name")
  appLogo            String?  @map("app_logo")
  primaryColor       String   @default("#3b82f6") @map("primary_color")
  footerText         String   @default("") @map("footer_text")
  turnstileEnabled   Boolean  @default(false) @map("turnstile_enabled")
  turnstileSiteKey   String?  @map("turnstile_site_key")
  turnstileSecretKey String?  @map("turnstile_secret_key")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Client {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  name        String
  logo        String?    // URL หรือ path ของ logo
  websiteUrl  String?    @map("website_url")
  totalBudget Float      @default(0) @map("total_budget")
  carryOver   Float      @default(0) @map("carry_over") // ยอดยกมา (ลบ = ใช้เกิน)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  campaignProfiles CampaignProfile[]
  budgetPeriods ClientBudgetPeriod[]
  pauseEvents PauseEvent[]

  @@map("clients")
}

model Campaign {
  id            Int       @id @default(autoincrement())
  clientId      Int?      @map("client_id") // nullable เพื่อเก็บประวัติเมื่อลบลูกค้า
  name          String
  budget        Float     @default(0)
  spent         Float     @default(0)
  startsOn      DateTime  @map("starts_on") @db.Date
  endDate       DateTime  @map("end_date")
  platform      String    // 'google_ads' or 'facebook_ads'
  googleAdsType String?   @map("google_ads_type") // 'search', 'display', 'pmax'
  activeDays    String?   @map("active_days") // JSON array: ["mon","tue","wed","thu","fri","sat"]
  isArchived    Boolean   @default(false) @map("is_archived")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  clientName    String?   @map("client_name") // เก็บชื่อลูกค้าไว้เมื่อลบลูกค้า
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  migratedPeriod CampaignPeriod? @relation("LegacyCampaignPeriod")

  @@map("campaigns")
}

// V2 campaign lifecycle. These tables are additive; Campaign remains the legacy record.
model CampaignProfile {
  id            Int      @id @default(autoincrement())
  clientId      Int      @map("client_id")
  name          String
  platform      String
  googleAdsType String?  @map("google_ads_type")
  activeDays    String?  @map("active_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periods       CampaignPeriod[]
  pauseCampaigns PauseEventCampaign[]

  @@index([clientId, isActive])
  @@map("campaign_profiles")
}

model ClientBudgetPeriod {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  month       DateTime @db.Date
  revision    Int      @default(0)
  baseBudget  Float    @map("base_budget")
  carryIn     Float    @default(0) @map("carry_in")
  carryOut    Float?   @map("carry_out")
  status      String   @default("OPEN")
  closeReason String?  @map("close_reason")
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns   CampaignPeriod[]

  @@unique([clientId, month, revision])
  @@index([clientId, status])
  @@map("client_budget_periods")
}

model CampaignPeriod {
  id                   Int      @id @default(autoincrement())
  campaignProfileId    Int      @map("campaign_profile_id")
  clientBudgetPeriodId Int      @map("client_budget_period_id")
  legacyCampaignId     Int?     @unique @map("legacy_campaign_id")
  budget               Float
  spent                Float    @default(0)
  startsOn             DateTime @map("starts_on") @db.Date
  endDate              DateTime @map("end_date") @db.Date
  status               String   @default("OPEN")
  closedAt             DateTime? @map("closed_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  campaignProfile      CampaignProfile @relation(fields: [campaignProfileId], references: [id], onDelete: Cascade)
  clientBudgetPeriod   ClientBudgetPeriod @relation(fields: [clientBudgetPeriodId], references: [id], onDelete: Cascade)
  legacyCampaign       Campaign? @relation("LegacyCampaignPeriod", fields: [legacyCampaignId], references: [id], onDelete: SetNull)

  @@unique([campaignProfileId, clientBudgetPeriodId])
  @@index([campaignProfileId, status])
  @@index([clientBudgetPeriodId, status])
  @@map("campaign_periods")
}

model PauseEvent {
  id          String   @id @default(cuid())
  clientId    Int      @map("client_id")
  createdById Int      @map("created_by_id")
  scope       String
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  reason      String   @default("ร้านปิด")
  status      String   @default("ACTIVE")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime @default(now()) @map("created_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("PauseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  campaigns   PauseEventCampaign[]

  @@index([clientId, status, startsOn, endsOn])
  @@map("pause_events")
}

model PauseEventCampaign {
  pauseEventId      String @map("pause_event_id")
  campaignProfileId Int    @map("campaign_profile_id")
  pauseEvent        PauseEvent @relation(fields: [pauseEventId], references: [id], onDelete: Cascade)
  campaignProfile   CampaignProfile @relation(fields: [campaignProfileId], references: [id], onDelete: Cascade)

  @@id([pauseEventId, campaignProfileId])
  @@index([campaignProfileId])
  @@map("pause_event_campaigns")
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String
  dueOn     DateTime @map("due_on") @db.Date
  entityType String  @map("entity_type")
  entityId  String   @map("entity_id")
  dedupeKey String   @unique @map("dedupe_key")
  isRead    Boolean  @default(false) @map("is_read")
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, dueOn])
  @@map("notifications")
}

model BudgetLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  clientName    String   @map("client_name")
  date          DateTime
  budgetMonth   DateTime @map("budget_month") @db.Date
  type          String   // 'RECEIVED' | 'TOPUP'
  amount        Float
  usableAmount  Float?   @map("usable_amount")
  platform      String?
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, budgetMonth])
  @@index([userId, date])
  @@map("budget_logs")
}

model ShareLink {
  id          String    @id @default(cuid())
  userId      Int       @map("user_id")
  token       String    @unique
  name        String?
  pageType    String    @default("all") @map("page_type") // "home" | "budget" | "all"
  expiresAt   DateTime? @map("expires_at")
  password    String?   // hashed password
  maxViews    Int?      @map("max_views")
  viewCount   Int       @default(0) @map("view_count")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs  ShareAccessLog[]

  @@index([token])
  @@index([userId])
  @@map("share_links")
}

model ShareAccessLog {
  id          String    @id @default(cuid())
  shareLinkId String    @map("share_link_id")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  accessedAt  DateTime  @default(now()) @map("accessed_at")

  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@map("share_access_logs")
}

enum NoteCategory {
  GENERAL
  CLIENT_PROJECT
  ACCESS
  TASK
}

enum NoteTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotePriority {
  LOW
  MEDIUM
  HIGH
}

enum NoteLinkKind {
  GOOGLE_SHEETS
  GOOGLE_DOCS
  GOOGLE_SLIDES
  GOOGLE_DRIVE
  WEBSITE
}

enum NoteSecretAccessType {
  PASSWORD
  SECURE_CONTENT
}

model Note {
  id               String          @id @default(cuid())
  ownerId          Int             @map("owner_id")
  category         NoteCategory    @default(GENERAL)
  title            String
  content          String          @default("")
  contentCiphertext String?        @map("content_ciphertext")
  contentIv        String?         @map("content_iv")
  contentAuthTag   String?         @map("content_auth_tag")
  contentKeyVersion Int?           @map("content_key_version")
  secureContentLineCount Int       @default(0) @map("secure_content_line_count")
  tags             String[]        @default([])
  isPinned         Boolean         @default(false) @map("is_pinned")
  clientName       String?         @map("client_name")
  host             String?
  loginUrl         String?         @map("login_url")
  username         String?
  secretCiphertext String?         @map("secret_ciphertext")
  secretIv         String?         @map("secret_iv")
  secretAuthTag    String?         @map("secret_auth_tag")
  secretKeyVersion Int?            @map("secret_key_version")
  taskStatus       NoteTaskStatus? @map("task_status")
  priority         NotePriority?   @map("priority")
  dueOn            DateTime?       @map("due_on") @db.Date
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  owner            User            @relation("OwnedNotes", fields: [ownerId], references: [id], onDelete: Cascade)
  shares           NoteShare[]
  secretAccessLogs NoteSecretAccessLog[]
  links           NoteLink[]

  @@index([ownerId, isPinned, updatedAt])
  @@index([ownerId, category, updatedAt])
  @@index([ownerId, taskStatus, dueOn])
  @@index([updatedAt])
  @@map("notes")
}

model NoteLink {
  id        String       @id @default(cuid())
  noteId    String       @map("note_id")
  url       String
  label     String
  kind      NoteLinkKind
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  note      Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, sortOrder])
  @@map("note_links")
}

model NoteShare {
  noteId         String   @map("note_id")
  userId         Int      @map("user_id")
  canViewSecret  Boolean  @default(false) @map("can_view_secret")
  createdAt      DateTime @default(now()) @map("created_at")
  note           Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user           User     @relation("SharedNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
  @@map("note_shares")
}

model NoteSecretAccessLog {
  id            String   @id @default(cuid())
  noteId        String   @map("note_id")
  actorUserId   Int      @map("actor_user_id")
  accessedAt    DateTime @default(now()) @map("accessed_at")
  accessType    NoteSecretAccessType @default(PASSWORD) @map("access_type")
  note          Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  actor         User     @relation("NoteSecretAccesses", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([noteId, accessedAt])
  @@index([actorUserId, accessedAt])
  @@map("note_secret_access_logs")
}
